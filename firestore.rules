rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    // Email admin déjà réglé (celui de ton compte Firebase Authentication)
    function admin() { return request.auth != null && request.auth.token.get('email', '').lower() == 'alexis.bouchaud7@gmail.com'; }

    match /rencontres/{r} {
      allow read: if true;
      allow write: if admin();
      match /matchs/{m} { allow read: if true; allow write: if admin(); }
    }
    match /clubs/{c} { allow read: if true; allow write: if admin(); }
    match /cartes/{c} { allow read, write: if admin(); }
    match /settings/{s} { allow read, write: if admin(); }
    match /players/{p} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == p
        && request.resource.data.keys().hasOnly(['pseudo', 'prenom', 'nom', 'points', 'invite'])
        && request.resource.data.points == 0
        && request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 40
        && request.resource.data.prenom is string && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() <= 30
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 30
        && request.resource.data.invite == get(/databases/$(d)/documents/settings/invite).data.token;
      allow update: if admin() || (request.auth != null && request.auth.uid == p
        && request.resource.data.points == resource.data.points
        && request.resource.data.keys().hasOnly(['pseudo', 'prenom', 'nom', 'points', 'invite']));
      allow delete: if admin();
    }
    match /bets/{b} {
      allow read: if admin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'r', 'm', 'choice'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.choice in ['a', 'b']
        && b == request.auth.uid + '_' + request.resource.data.r + '_' + request.resource.data.m
        && exists(/databases/$(d)/documents/players/$(request.auth.uid))
        && request.time < get(/databases/$(d)/documents/rencontres/$(request.resource.data.r)).data.debut;
    }
  }
}

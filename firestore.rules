rules_version = '2';
service cloud.firestore {
  match /databases/{d}/documents {
    // Remplace par TON email admin (celui créé dans Firebase Authentication)
    function admin() { return request.auth != null && request.auth.token.email == 'alexis.bouchaud7@gmail.com'; }

    match /matches/{m} {
      allow read: if true;
      allow write: if admin();
      match /votes/{v} {
        allow read: if true;
        allow create: if get(/databases/$(d)/documents/matches/$(m)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['choice'])
          && request.resource.data.choice in ['us', 'them'];
        allow delete: if admin();
      }
    }
    match /codes/{c} {
      allow get: if true;
      allow list, write: if admin();
    }
    match /voted/{v} {
      allow get: if true;
      allow create: if exists(/databases/$(d)/documents/codes/$(request.resource.data.code))
        && v == request.resource.data.code + '_' + request.resource.data.match;
      allow delete: if admin();
    }
  }
}
